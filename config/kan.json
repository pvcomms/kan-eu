{
  "ollama": "http://127.0.0.1:11434",
  "models": {
    "fast": { "model": "kan-ministral-3b:latest", "think": false },
    "deep": { "model": "ministral-3:8b", "think": false }
  },
  "system1": "kan-ministral-3b:latest",
  "identity": ["identity/SOUL.md", "identity/USER.md"],
  "memory": {
    "db": "data/memory.db",
    "embed": "kan-mxbai-xsmall:latest",
    "query_prefix": "",
    "doc_prefix": "",
    "k": 6,
    "min_score": 0.25,
    "gate": 0.3,
    "question": "Should the assistant use these notes to answer the message?",
    "threshold": 0.5,
    "hints": {
      "use": "the notes contain information that answers the message",
      "ignore": "the notes are unrelated; the message is answerable without them"
    },
    "sources": [
      { "name": "examples", "dir": "examples/notes" }
    ]
  }
}
